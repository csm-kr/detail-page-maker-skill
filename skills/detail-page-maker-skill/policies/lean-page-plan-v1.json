{
  "id": "lean-page-plan-v1",
  "version": "1.0.0",
  "required_top_level": [
    "contract_id",
    "inputs",
    "output",
    "sections",
    "still_jobs",
    "gif_briefs",
    "qa"
  ],
  "inputs": {
    "required": ["supplier_url", "coupang_url"],
    "optional": ["photo_paths"],
    "coupang_host_suffix": "coupang.com"
  },
  "output": {
    "width_px": 780,
    "html_path": "output/detail-page.html",
    "studio_required": true,
    "wing_required": true,
    "cdn_required": true,
    "forbid_half_width_profile": true
  },
  "sections": {
    "minimum": 1,
    "one_message_required": true,
    "copy_fields": [
      "headline_lines",
      "body_chunks",
      "emphasis_chunks"
    ],
    "headline_lines": { "minimum": 1, "maximum": 3 },
    "body_chunks": { "minimum": 0, "maximum": 3 },
    "emphasis_chunks": { "minimum": 0, "maximum": 3 }
  },
  "still_jobs": {
    "minimum": 28,
    "target": 30,
    "maximum": 32,
    "required_fields": ["id", "section_id", "purpose", "prompt", "width_px"]
  },
  "gif_briefs": {
    "minimum": 8,
    "target": 10,
    "maximum": 12,
    "required_fields": [
      "id",
      "section_id",
      "width_px",
      "question",
      "start",
      "action",
      "result"
    ]
  },
  "qa": {
    "semantic_chunk_review_required": true,
    "final_render_review_required": true,
    "final_render_width_px": 780,
    "required_copy_checks": [
      "line_meaning_complete",
      "particle_binding",
      "number_unit_binding",
      "modifier_binding",
      "key_phrase_integrity"
    ]
  }
}
